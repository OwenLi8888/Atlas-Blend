# --- API server (api/) ---
PORT=8787
# Public base URL the phones use to reach the API (your laptop's LAN IP)
PUBLIC_BASE_URL=http://192.168.1.10:8787
# Optional: Supabase. Without these the API uses a local JSON store + local file storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=blend
# Python executable used to run /blend and /agent
PYTHON=python

# --- Blend service (blend/) ---
# Optional: image model with reference images. Without it, the still is built from the
# bridge artwork + matched-pair references and color-corrected to the merged targets.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1

# --- Research agent (agent/) ---
# Optional: without a key the agent runs its deterministic grounded fallback.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5

# --- Painting worker (worker/) ---
# Optional: module name of the pre-existing stroke-painting engine package.
PAINT_ENGINE=
PAINT_SIZE=640
